'use client'

import { useEffect, useMemo, useState } from 'react'
import { useAuthContext } from '@/context/AuthContext'
import { getJobs, assignJobToUser, unassignJob } from '@/lib/jobs'
import { getAS3000ClauseForJob } from '@/lib/as3000'
import { getTenantMembers } from '@/lib/auth'
import { detectConflicts, rankMembersForJob, dailyCapacityHours, getWorkHours } from '@/lib/schedule'
import type { Job, TenantMember, Profile } from '@/types/database'

function formatDateKey(date: Date) {
  return date.toISOString().slice(0, 10)
}

function startingMonday(date: Date) {
  const copy = new Date(date)
  const diff = (copy.getDay() + 6) % 7
  copy.setDate(copy.getDate() - diff)
  copy.setHours(0, 0, 0, 0)
  return copy
}

function addDays(date: Date, days: number) {
  const next = new Date(date)
  next.setDate(next.getDate() + days)
  return next
}

function formatDayLabel(date: Date) {
  return date.toLocaleDateString(undefined, { weekday: 'short', day: 'numeric', month: 'short' })
}

function formatNiceDate(date: Date) {
  return date.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' })
}

export default function SchedulePage() {
  const { currentTenant } = useAuthContext()
  const [jobs, setJobs] = useState<Job[]>([])
  const [members, setMembers] = useState<(TenantMember & { profiles: Profile })[]>([])
  const [loading, setLoading] = useState(true)
  const [error, setError] = useState<string | null>(null)
  const [success, setSuccess] = useState<string | null>(null)
  const [selectedWeekStart, setSelectedWeekStart] = useState<Date>(() => startingMonday(new Date()))
  const [updatingJob, setUpdatingJob] = useState<Record<string, boolean>>({})

  useEffect(() => {
    const fetchData = async () => {
      if (!currentTenant) return
      setLoading(true)
      setError(null)
      setSuccess(null)
      try {
        const [jobsData, membersData] = await Promise.all([
          getJobs(currentTenant.id),
          getTenantMembers(currentTenant.id),
        ])
        setJobs(jobsData)
        setMembers(membersData)
      } catch (err: any) {
        setError(err?.message || 'Unable to load schedule data.')
      } finally {
        setLoading(false)
      }
    }
    fetchData()
  }, [currentTenant])

  const weekDates = useMemo(
    () => Array.from({ length: 7 }, (_, i) => addDays(selectedWeekStart, i)),
    [selectedWeekStart]
  )

  const jobsByDate = useMemo(() => {
    return jobs.reduce<Record<string, Job[]>>((groups, job) => {
      const key = job.due_date ? formatDateKey(new Date(job.due_date)) : 'unscheduled'
      groups[key] = groups[key] || []
      groups[key].push(job)
      return groups
    }, {})
  }, [jobs])

  const unscheduledJobs = useMemo(() => jobs.filter((j) => !j.due_date), [jobs])

  // Conflict detection: double-bookings + overbooked days vs working-hours capacity
  const conflicts = useMemo(() => detectConflicts(jobs, currentTenant), [jobs, currentTenant])
  const conflictJobIds = useMemo(() => new Set(conflicts.flatMap((c) => c.jobIds)), [conflicts])
  const capacity = useMemo(() => dailyCapacityHours(getWorkHours(currentTenant)), [currentTenant])

  const memberName = (userId: string) => {
    const m = members.find((mm) => mm.user_id === userId)
    return m?.profiles?.full_name || m?.profiles?.email || 'Unknown'
  }

  const handleAssign = async (jobId: string, userId: string) => {
    setError(null); setSuccess(null)
    setUpdatingJob((c) => ({ ...c, [jobId]: true }))
    try {
      await assignJobToUser(jobId, userId)
      setSuccess('Employee assigned.')
      const refreshed = await getJobs(currentTenant!.id)
      setJobs(refreshed)
    } catch (err: any) {
      setError(err?.message || 'Unable to assign the job.')
    } finally {
      setUpdatingJob((c) => ({ ...c, [jobId]: false }))
    }
  }

  const handleUnassign = async (jobId: string) => {
    setError(null); setSuccess(null)
    setUpdatingJob((c) => ({ ...c, [jobId]: true }))
    try {
      await unassignJob(jobId)
      setSuccess('Employee unassigned.')
      const refreshed = await getJobs(currentTenant!.id)
      setJobs(refreshed)
    } catch (err: any) {
      setError(err?.message || 'Unable to remove assignment.')
    } finally {
      setUpdatingJob((c) => ({ ...c, [jobId]: false }))
    }
  }

  const btnCls = 'rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors'

  return (
    <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

      {/* Header */}
      <div className="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h1 className="text-3xl font-bold text-slate-900">Schedule</h1>
          <p className="text-slate-500 mt-1">Weekly job calendar — assign crew and manage scheduling</p>
        </div>
        <div className="flex items-center gap-2">
          <button type="button" onClick={() => setSelectedWeekStart((c) => addDays(c, -7))} className={btnCls}>← Previous</button>
          <button type="button" onClick={() => setSelectedWeekStart(startingMonday(new Date()))} className={btnCls}>Today</button>
          <button type="button" onClick={() => setSelectedWeekStart((c) => addDays(c, 7))} className={btnCls}>Next →</button>
        </div>
      </div>

      {/* Stat row */}
      <div className="grid grid-cols-4 gap-4">
        {[
          { label: 'Total jobs', value: jobs.length, color: 'text-slate-900' },
          { label: 'Assigned', value: jobs.filter((j) => j.assigned_to).length, color: 'text-[#4a9c4a]' },
          { label: 'Unscheduled', value: unscheduledJobs.length, color: 'text-sky-600' },
          { label: 'Conflicts', value: conflicts.length, color: conflicts.length ? 'text-red-600' : 'text-slate-900' },
        ].map((s) => (
          <div key={s.label} className="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
            <p className="text-sm text-slate-500">{s.label}</p>
            <p className={`mt-2 text-3xl font-bold ${s.color}`}>{s.value}</p>
          </div>
        ))}
      </div>

      {error && <div className="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700">{error}</div>}
      {success && <div className="rounded-lg border border-green-200 bg-green-50 p-4 text-sm text-green-700">{success}</div>}

      {/* Conflict warnings */}
      {conflicts.length > 0 && (
        <div className="rounded-xl border border-red-200 bg-red-50 p-5">
          <h2 className="text-sm font-bold text-red-800 uppercase tracking-wide">
            ⚠ {conflicts.length} scheduling conflict{conflicts.length > 1 ? 's' : ''}
          </h2>
          <ul className="mt-2 space-y-1">
            {conflicts.map((c, i) => (
              <li key={i} className="text-sm text-red-700">
                <span className="font-semibold">{memberName(c.userId)}</span>: {c.message}
                {c.type === 'double_booked' ? ' — two jobs can’t start at once.' : ''}
              </li>
            ))}
          </ul>
          <p className="mt-2 text-xs text-red-500">Capacity is based on your workspace working hours ({capacity.toFixed(1)}h/day). Adjust under Settings.</p>
        </div>
      )}

      {/* Week grid */}
      <div className="grid gap-4 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4">
        {weekDates.map((date) => {
          const dateKey = formatDateKey(date)
          const dayJobs = jobsByDate[dateKey] ?? []
          const isToday = formatDateKey(date) === formatDateKey(new Date())

          return (
            <div key={dateKey} className={`rounded-xl border bg-white p-5 shadow-sm ${isToday ? 'border-[#4a9c4a]' : 'border-slate-200'}`}>
              <div className="flex items-center justify-between mb-4">
                <div>
                  <p className="text-xs font-medium text-slate-400 uppercase tracking-wider">{formatDayLabel(date)}</p>
                  {isToday && <span className="mt-0.5 inline-block text-xs font-semibold text-[#4a9c4a]">Today</span>}
                </div>
                <span className="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600">
                  {dayJobs.length} jobs
                </span>
              </div>

              {loading ? (
                <div className="text-sm text-slate-400">Loading…</div>
              ) : dayJobs.length === 0 ? (
                <div className="rounded-lg border border-dashed border-slate-200 bg-slate-50 p-4 text-sm text-slate-400 text-center">
                  No jobs
                </div>
              ) : (
                <div className="space-y-3">
                  {dayJobs.map((job) => {
                    const assignedMember = members.find((m) => m.user_id === job.assigned_to)
                    const clause = getAS3000ClauseForJob(job.title, job.description || '')
                    const hasConflict = conflictJobIds.has(job.id)
                    return (
                      <div key={job.id} className={`rounded-lg border p-3 ${hasConflict ? 'border-red-300 bg-red-50' : 'border-slate-100 bg-slate-50'}`}>
                        {hasConflict && (
                          <p className="mb-1.5 text-[10px] font-bold uppercase tracking-wide text-red-600">⚠ Conflict</p>
                        )}
                        <div className="flex items-start justify-between gap-2">
                          <div className="min-w-0">
                            <h3 className="text-sm font-semibold text-slate-900 leading-tight">{job.title}</h3>
                            {job.description && (
                              <p className="text-xs text-slate-500 mt-0.5 line-clamp-1">{job.description}</p>
                            )}
                          </div>
                          <span className="shrink-0 rounded-full bg-white border border-slate-200 px-2 py-0.5 text-[10px] font-semibold text-slate-500 capitalize">
                            {job.status.replace('_', ' ')}
                          </span>
                        </div>

                        <div className="mt-2 flex items-center gap-2 text-xs text-slate-500">
                          <span className="capitalize">{job.priority}</span>
                          {job.estimated_hours && <span>• {job.estimated_hours}h</span>}
                        </div>

                        <div className="mt-2 text-xs text-slate-600">
                          <span className="text-slate-400">Crew: </span>
                          {assignedMember?.profiles?.full_name || assignedMember?.profiles?.email || 'Unassigned'}
                        </div>

                        {clause && (
                          <div className="mt-2 rounded-md bg-green-50 border border-green-100 px-3 py-1.5 text-xs text-green-700">
                            {clause.reference} — {clause.title}
                          </div>
                        )}

                        <div className="mt-3">
                          {job.assigned_to ? (
                            <button
                              type="button"
                              disabled={updatingJob[job.id]}
                              onClick={() => handleUnassign(job.id)}
                              className="w-full rounded-md bg-red-50 border border-red-100 px-3 py-1.5 text-xs font-semibold text-red-600 hover:bg-red-100 transition-colors disabled:opacity-50"
                            >
                              {updatingJob[job.id] ? 'Updating…' : 'Unassign crew'}
                            </button>
                          ) : (
                            <select
                              disabled={updatingJob[job.id] || members.length === 0}
                              onChange={(e) => { if (e.target.value) { handleAssign(job.id, e.target.value); e.target.value = '' } }}
                              className="w-full rounded-md border border-slate-300 bg-white px-3 py-1.5 text-xs text-slate-700 outline-none focus:border-[#4a9c4a]"
                              defaultValue=""
                            >
                              <option value="" disabled>Assign crew member</option>
                              {rankMembersForJob(job, members).map((m) => (
                                <option key={m.user_id} value={m.user_id}>
                                  {m.matchScore > 0 ? '★ ' : ''}{m.profiles?.full_name || m.profiles?.email}
                                  {m.matchScore > 0 ? ` — skills match (${m.matchScore})` : ''}
                                </option>
                              ))}
                            </select>
                          )}
                        </div>
                      </div>
                    )
                  })}
                </div>
              )}
            </div>
          )
        })}
      </div>

      {/* Unscheduled */}
      <div className="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <div className="flex items-center justify-between gap-4 mb-4">
          <div>
            <h2 className="text-lg font-semibold text-slate-900">Unscheduled jobs</h2>
            <p className="text-sm text-slate-500 mt-0.5">Jobs without a due date — assign crew or set a date to schedule them</p>
          </div>
        </div>

        {loading ? (
          <div className="text-sm text-slate-400">Loading…</div>
        ) : unscheduledJobs.length === 0 ? (
          <div className="rounded-lg border border-dashed border-slate-200 bg-slate-50 p-5 text-sm text-slate-400 text-center">
            All jobs are scheduled.
          </div>
        ) : (
          <div className="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {unscheduledJobs.map((job) => {
              const assignedMember = members.find((m) => m.user_id === job.assigned_to)
              return (
                <div key={job.id} className="rounded-lg border border-slate-100 bg-slate-50 p-4">
                  <div className="flex items-start justify-between gap-2">
                    <h3 className="text-sm font-semibold text-slate-900">{job.title}</h3>
                    <span className="shrink-0 rounded-full bg-white border border-slate-200 px-2 py-0.5 text-[10px] font-semibold text-slate-500 capitalize">
                      {job.status.replace('_', ' ')}
                    </span>
                  </div>
                  <div className="mt-1 grid grid-cols-2 gap-2 text-xs text-slate-500">
                    <span>Crew: {assignedMember?.profiles?.full_name || 'Unassigned'}</span>
                    <span className="capitalize">Priority: {job.priority}</span>
                  </div>
                  <div className="mt-3">
                    {job.assigned_to ? (
                      <button
                        type="button"
                        disabled={updatingJob[job.id]}
                        onClick={() => handleUnassign(job.id)}
                        className="w-full rounded-md bg-red-50 border border-red-100 px-3 py-1.5 text-xs font-semibold text-red-600 hover:bg-red-100 transition-colors disabled:opacity-50"
                      >
                        {updatingJob[job.id] ? 'Updating…' : 'Unassign crew'}
                      </button>
                    ) : (
                      <select
                        disabled={updatingJob[job.id] || members.length === 0}
                        onChange={(e) => { if (e.target.value) { handleAssign(job.id, e.target.value); e.target.value = '' } }}
                        className="w-full rounded-md border border-slate-300 bg-white px-3 py-1.5 text-xs text-slate-700 outline-none focus:border-[#4a9c4a]"
                        defaultValue=""
                      >
                        <option value="" disabled>Assign crew member</option>
                        {rankMembersForJob(job, members).map((m) => (
                          <option key={m.user_id} value={m.user_id}>
                            {m.matchScore > 0 ? '★ ' : ''}{m.profiles?.full_name || m.profiles?.email}
                            {m.matchScore > 0 ? ` — skills match (${m.matchScore})` : ''}
                          </option>
                        ))}
                      </select>
                    )}
                  </div>
                </div>
              )
            })}
          </div>
        )}
      </div>
    </div>
  )
}
