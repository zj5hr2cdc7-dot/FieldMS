# FieldMS environment variables
#
# Copy to .env.local for development. For production, paste each of these into
# your host's environment settings (Vercel: Project > Settings > Environment
# Variables). They are NOT read from the repo, and the build will succeed
# without them and then fail at runtime, which is the worst way to find out.
#
# Check what is actually set with:  npm run doctor
#
# NEVER commit real values. .env* is gitignored.

# ── Required: the app does not work without these ────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row level security, so it must never be prefixed
# NEXT_PUBLIC_ and never appear in a browser. Used by utils/supabase/admin.ts
# for the public quote, invoice, certificate and unsubscribe pages.
SUPABASE_SERVICE_ROLE_KEY=

# Server only. Powers FieldMS Fault Finder.
ANTHROPIC_API_KEY=

# ── Optional: each one switches a feature on ─────────────────
# Sending quotes and invoices by email
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# SMS job notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Job maps and live tracking
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Xero connection
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_SCOPE=

# MYOB connection
MYOB_CLIENT_ID=
MYOB_CLIENT_SECRET=
MYOB_API_KEY=
MYOB_SCOPE=
MYOB_API_VERSION=

# Scheduled supplier price refresh. With this unset the cron path is simply
# unreachable and /api/pricing/refresh falls back to requiring a signed-in
# user, so it fails closed rather than open.
CRON_SECRET=
